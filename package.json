{
  "name": "dsh-cpa-plus",
  "version": "0.3.0",
  "description": "DeepSeek Harness subscriptions plugin: Cursor + Factory Droid + built-in managed CLIProxyAPI (Claude Code / Codex / etc.)",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "host.js",
    "commands.js",
    "cursor/",
    "cliproxy/",
    "client/",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.24"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cursor",
    "cliproxyapi",
    "claude-code",
    "codex",
    "llm-adapter"
  ]
}
