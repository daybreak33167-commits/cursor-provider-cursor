  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "adapter.js",
    "session.js",
    "prompt.js",
    "host.js",
    "oauth.js",
    "catalog.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
